<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <Owners>torutek</Owners>
    <Authors>torutek, Rico Suter</Authors>
    <Description>Specification and code generator for SignalR Core.</Description>
    <Version>0.3.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageProjectUrl>https://github.com/torutek/SigSpec</PackageProjectUrl>
    <RepositoryUrl>https://github.com/torutek/SigSpec.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>SignalR Specification CodeGeneration</PackageTags>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NJsonSchema.NewtonsoftJson" />
  </ItemGroup>
</Project>